# Variables de entorno
# Configuración del servidor
PORT=3000

# Credenciales y Configuración de Bicom ERP (Rellenar cuando se tengan)
BICOM_API_URL=
BICOM_API_KEY=
BICOM_USER=
BICOM_PASSWORD=

# Configuración de Base de Datos (PostgreSQL / Supabase)
# Opción 1: Usando DATABASE_URL única (Recomendada para Supabase/Render/Railway)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres

# Opción 2: Usando variables separadas (Fallback)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=contrasena
DB_NAME=distribuidora
DB_SSL=true

